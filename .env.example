# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy compatibility; use the publishable key above for new deployments.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional market/news providers
CURRENT_GOLD_API_URL=
CURRENT_GOLD_API_KEY=
MARKETAUX_API_TOKEN=
NEWSDATA_API_KEY=

# Public market data. These are server-only provider keys.
ALPHA_VANTAGE_API_KEY=
EODHD_API_KEY=
# Keep false until the provider explicitly permits commercial external display/redistribution.
MARKET_DATA_DISPLAY_LICENSED=false
# auto | alpha | eodhd
MARKET_DATA_PROVIDER=auto

# Never expose SUPABASE_SERVICE_ROLE_KEY or provider private keys to the browser.
